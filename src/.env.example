APP_ENV="local"

# PostgreSQL Credentials (for local development)
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

POSTGRES_USER=hoteluser
POSTGRES_PASSWORD=hotelpass
POSTGRES_DB=hotelsdb

# Database connection string (optional, auto-constructed if above are set)
# DATABASE_URL=postgresql+asyncpg://hoteluser:hotelpass@localhost:5432/hotelsdb

# LLM Configurations
## Hosted/local OpenRouter-style mode:
LLM_PROVIDER_API_KEY="your-llm-provider-api-key-here"
LLM_PROVIDER_MODEL="openrouter/free"

## Fully local llama.cpp mode:
# APP_ENV=local
LLAMACPP_BASE_URL="http://host.docker.internal:8080"
LLM_PROVIDER_MODEL="gemma-4-12B-it-qat-UD-Q4_K_XL.gguf"

# Langfuse Observability
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST="your-langfuse-host" # e.g., "http://langfuse-web:3000"

# BigQuery Configuration (optional for external signals)
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
